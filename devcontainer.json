{
  "name": "Search Service (Go + PostgreSQL/pgvector)",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "runServices": ["workspace", "postgres"],
  "workspaceFolder": "/workspaces/search-service",
  "remoteUser": "vscode",
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  }
}
